JUNE_PERSONA_PATH=persona/SOUL.md
JUNE_DATA_DIR=./data
JUNE_LOG_LEVEL=INFO
JUNE_LLM_PROVIDER=mock
# mock | openai. A real provider requires JUNE_LLM_API_KEY and JUNE_LLM_MODEL.
JUNE_LLM_MODEL=mock
# Secret: set in the environment or an untracked .env, never commit a real key.
JUNE_LLM_API_KEY=
# Optional: any OpenAI-compatible endpoint.
JUNE_LLM_BASE_URL=
JUNE_LLM_TIMEOUT_SECONDS=30
JUNE_LLM_MAX_RETRIES=2
